{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sound-passport",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": ["SPOTIPY_CLIENT_ID", "SPOTIPY_CLIENT_SECRET", "SPOTIPY_REDIRECT_URI"]
  },
  "main": "./worker/index.ts",
  "preview_urls": true
}
